+typedef struct DynamicSysbusAcpiContext {
+    VirtMachineState *vms;
+    Aml *scope;
+    PlatformBusDevice *pbus;
+    uint32_t uart_count;
+} DynamicSysbusAcpiContext;
+
+static void acpi_dsdt_add_amba_uart(SysBusDevice *sbdev, void *opaque)
+{
+    DynamicSysbusAcpiContext *ctx = opaque;
+    VirtMachineState *vms = ctx->vms;
+    PlatformBusDevice *pbus = ctx->pbus;
+    Aml *scope = ctx->scope;
+    MemoryRegion *mr;
+    hwaddr mmio_offset, absolute_gpa;
+    int irqn;
+    uint32_t intid;
+    char nameseg[5];
+    Aml *dev, *crs, *dsd, *props_list, *prop_io_width, *prop_clk;
+
+    if (!vfio_platform_device_has_compatible(sbdev, "ambarella,uart")) {
+        return;
+    }
+
+    if (ctx->uart_count >= 10) {
+        error_setg(&error_fatal,
+                   "Too many Ambarella UART devices (maximum 10: URT0-URT9)");
+        return;
+    }
+
+    /* Require MMIO region 0 to exist and have size exactly 0x1000 */
+    if (sbdev->num_mmio < 1) {
+        error_setg(&error_fatal, "Ambarella UART device has no MMIO regions");
+        return;
+    }
+
+    mr = sysbus_mmio_get_region(sbdev, 0);
+    if (!mr || memory_region_size(mr) != 0x1000) {
+        error_setg(&error_fatal,
+                   "Ambarella UART region size mismatch (want 0x1000, got 0x%" PRIx64 ")",
+                   mr ? (uint64_t)memory_region_size(mr) : 0);
+        return;
+    }
+
+    mmio_offset = platform_bus_get_mmio_addr(pbus, sbdev, 0);
+    if (mmio_offset == (hwaddr)-1) {
+        error_setg(&error_fatal,
+                   "Ambarella UART MMIO region 0 not mapped on platform bus");
+        return;
+    }
+
+    absolute_gpa = vms->memmap[VIRT_PLATFORM_BUS].base + mmio_offset;
+    if (absolute_gpa + 0x1000 > UINT32_MAX) {
+        error_setg(&error_fatal,
+                   "Ambarella UART absolute GPA 0x%" PRIx64 " does not fit in Memory32Fixed",
+                   absolute_gpa);
+        return;
+    }
+
+    irqn = platform_bus_get_irqn(pbus, sbdev, 0);
+    if (irqn < 0) {
+        error_setg(&error_fatal,
+                   "Ambarella UART IRQ 0 not mapped on platform bus");
+        return;
+    }
+
+    intid = ARM_SPI_BASE + vms->irqmap[VIRT_PLATFORM_BUS] + irqn;
+
+    snprintf(nameseg, sizeof(nameseg), "URT%u", ctx->uart_count);
+    dev = aml_device("%s", nameseg);
+    aml_append(dev, aml_name_decl("_HID", aml_string("AMBA0001")));
+    aml_append(dev, aml_name_decl("_UID", aml_int(ctx->uart_count)));
+
+    crs = aml_resource_template();
+    aml_append(crs, aml_memory32_fixed((uint32_t)absolute_gpa, 0x1000, AML_READ_WRITE));
+    aml_append(crs, aml_interrupt(AML_CONSUMER, AML_LEVEL, AML_ACTIVE_HIGH,
+                                  AML_EXCLUSIVE, &intid, 1));
+    aml_append(dev, aml_name_decl("_CRS", crs));
+
+    /*
+     * _DSD Device Properties UUID: daffd814-6eba-4d8c-8a91-bc9bbf4aa301
+     * Properties:
+     *   "reg-io-width" = 4
+     *   "clock-frequency" = 24000000
+     */
+    prop_io_width = aml_package(2);
+    aml_append(prop_io_width, aml_string("reg-io-width"));
+    aml_append(prop_io_width, aml_int(4));
+
+    prop_clk = aml_package(2);
+    aml_append(prop_clk, aml_string("clock-frequency"));
+    aml_append(prop_clk, aml_int(24000000));
+
+    props_list = aml_package(2);
+    aml_append(props_list, prop_io_width);
+    aml_append(props_list, prop_clk);
+
+    dsd = aml_package(2);
+    aml_append(dsd, aml_touuid("DAFFD814-6EBA-4D8C-8A91-BC9BBF4AA301"));
+    aml_append(dsd, props_list);
+    aml_append(dev, aml_name_decl("_DSD", dsd));
+
+    aml_append(scope, dev);
+    ctx->uart_count++;
+}
